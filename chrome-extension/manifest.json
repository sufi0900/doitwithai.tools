{
  "manifest_version": 3,
  "name": "Do It With AI: SEO Inspector, Content Converter & Social Studio",
  "short_name": "DoItWithAI Studio",
  "version": "1.0.0",
  "description": "All-in-one On-Page & Technical SEO Toolbar, E-E-A-T & Information Gain Scorer, 1-Click Article Converter (PDF/Word/MD/MP3), and 15-Post Social Studio.",
  "homepage_url": "https://doitwithai.tools/chrome-extension",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Do It With AI — SEO, Content & Social Studio",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
