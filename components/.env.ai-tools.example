# Server-only. Never use NEXT_PUBLIC_ for API credentials.
GEMINI_API_KEY=
# Shared by the AI tools. Use an available structured-output and image-capable model.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional per-tool overrides. Leave blank to use GEMINI_MODEL.
GEMINI_META_TITLE_MODEL=
GEMINI_SLUG_GENERATOR_MODEL=
GEMINI_SCHEMA_ANALYZER_MODEL=
GEMINI_META_DESCRIPTION_MODEL=
GEMINI_H1_HEADING_MODEL=
GEMINI_ARTICLE_OUTLINE_MODEL=
GEMINI_READABILITY_MODEL=
GEMINI_ALT_TEXT_MODEL=
GEMINI_KEYWORD_CLUSTERING_MODEL=
GEMINI_TOPICAL_MAP_MODEL=
GEMINI_INTERNAL_LINKING_MODEL=

# Secondary provider. Gemini is tried first; Groq is used automatically on service/output failures.
# Only GROQ_API_KEY is required to enable fallback; the models below are built-in defaults.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

AI_TOOLS_DAILY_LIMIT=5
AI_TOOLS_BURST_LIMIT=3
# Required for shared production rate limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional legacy assistant vector-store backend. The current Gemini/Groq assistant path does not require these.
OPENAI_API_KEY=
OPENAI_SITE_ASSISTANT_MODEL=
OPENAI_SITE_ASSISTANT_VECTOR_STORE_ID=

# Optional existing-provider model override for intent analysis
# GEMINI_SEARCH_INTENT_MODEL=

# Optional existing-provider model override for content briefs
# GEMINI_CONTENT_BRIEF_MODEL=

# Optional Gemini model override for source-backed FAQ generation
# GEMINI_FAQ_MODEL=
