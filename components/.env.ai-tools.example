# Server-only. Never prefix this variable with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Cost-sensitive default for this short, structured generation workload.
OPENAI_META_TITLE_MODEL=gpt-5.6-luna

# Anonymous public-use guardrails.
AI_TOOLS_DAILY_LIMIT=5
AI_TOOLS_BURST_LIMIT=3

# Recommended for production so limits work across serverless instances.
# Without these, the first draft uses an in-memory development fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Image Alt Text Generator: set a model with image input and structured-output support.
OPENAI_ALT_TEXT_MODEL=
