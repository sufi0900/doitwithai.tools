# Server-only. Never use NEXT_PUBLIC_ for API credentials.
GEMINI_API_KEY=
# Shared by all ten tools. Use an available structured-output and image-capable model.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional per-tool overrides. Leave blank to use GEMINI_MODEL.
GEMINI_META_TITLE_MODEL=
GEMINI_SLUG_GENERATOR_MODEL=
GEMINI_SCHEMA_ANALYZER_MODEL=
GEMINI_META_DESCRIPTION_MODEL=
GEMINI_H1_HEADING_MODEL=
GEMINI_ARTICLE_OUTLINE_MODEL=
GEMINI_READABILITY_MODEL=
GEMINI_ALT_TEXT_MODEL=
GEMINI_KEYWORD_CLUSTERING_MODEL=
GEMINI_TOPICAL_MAP_MODEL=

AI_TOOLS_DAILY_LIMIT=5
AI_TOOLS_BURST_LIMIT=3
# Required for shared production rate limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The separate site assistant still uses OpenAI file-search/vector-store services.
# Configure these only if keeping that assistant enabled.
OPENAI_API_KEY=
OPENAI_SITE_ASSISTANT_MODEL=
OPENAI_SITE_ASSISTANT_VECTOR_STORE_ID=
